<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="window-size" content="424x355">
<title>mode</title>
<style>
body{margin:0;font-family:Arial,sans-serif;background:#0008ff;}
.stage{position:relative;width:404px;height:315px;margin:0 auto;}
.stage > *{position:absolute;margin:0;}
button{padding:0 10px;height:25px;cursor:pointer;border:1px solid #8e8e8e;background:linear-gradient(#f4f4f4,#dedede);color:#202020;font-size:13px;}
input{padding:0 5px;height:25px;width:180px;font-size:13px;border:1px solid #9a9a9a;box-sizing:border-box;}
</style>
</head>
<body>
<div class="stage">
<p style="left:7px;top:4px;color:#ffffff;font-weight:900;">MiUX Normal work mode</p>
<p style="left:6px;top:31px;color:#ffffff;font-weight:300;">MiUX 7.0.0 build 17.10.2026</p>
</div>
</body>
</html>